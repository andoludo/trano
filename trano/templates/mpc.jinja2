{#-
  CasADi-compatible resistance-capacitance (RC) building models.

  Every model rendered here is written in the Modelica subset that can be translated
  symbolically into a CasADi explicit ODE ``xdot = f(t, x, u, p)``:

  * flat and scalar models (no sub-components, no arrays, no connectors),
  * explicit state equations ``der(x) = expression`` (no algebraic variables),
  * parameters bound to literal values only (no parameter expressions),
  * smooth equations: no events, no tables, no ``if``, ``min``/``max`` or ``abs``,
  * no dependency on any external library (not even the Modelica Standard Library).

  The zone equations are defined once in the ``*_equations`` macros below and are
  reused both for the ``Trano.MPC.Zones`` library (embedded in the Trano package,
  see ``Trano.jinja2``) and for the flat multi-zone building model generated with
  the ``mpc`` library (see ``mpc_base.jinja2``), so that both always stay consistent.
-#}

{%- macro heat_flow(zone, p) -%}
{{ p }}gA*HGlo + {{ p }}QInt
{%- for coupling in zone.couplings %} + {{ coupling.parameter }}*({{ coupling.neighbour }}Ti - {{ p }}Ti){% endfor -%}
{%- endmacro -%}

{%- macro r1c1_equations(zone, p) %}
  der({{ p }}Ti) = ((TOut - {{ p }}Ti)/{{ p }}Ria + (TGro - {{ p }}Ti)/{{ p }}Rig + {{ heat_flow(zone, p) }} + {{ p }}QHea)/{{ p }}Ci;
{%- endmacro -%}

{%- macro envelope_equation(p) %}
  der({{ p }}Te) = (({{ p }}Ti - {{ p }}Te)/{{ p }}Rie + (TOut - {{ p }}Te)/{{ p }}Rea + (TGro - {{ p }}Te)/{{ p }}Reg + {{ p }}aE*HGlo)/{{ p }}Ce;
{%- endmacro -%}

{%- macro r3c2_equations(zone, p) %}
  der({{ p }}Ti) = (({{ p }}Te - {{ p }}Ti)/{{ p }}Rie + (TOut - {{ p }}Ti)/{{ p }}Ria + {{ heat_flow(zone, p) }} + {{ p }}QHea)/{{ p }}Ci;
{{ envelope_equation(p) }}
{%- endmacro -%}

{%- macro r4c3_equations(zone, p) %}
  der({{ p }}Ti) = (({{ p }}Te - {{ p }}Ti)/{{ p }}Rie + (TOut - {{ p }}Ti)/{{ p }}Ria + ({{ p }}Th - {{ p }}Ti)/{{ p }}Rih + {{ heat_flow(zone, p) }})/{{ p }}Ci;
{{ envelope_equation(p) }}
  der({{ p }}Th) = (({{ p }}Ti - {{ p }}Th)/{{ p }}Rih + {{ p }}QHea)/{{ p }}Ch;
{%- endmacro -%}

{%- macro iso13790_surface_temperature(p) -%}
(({{ p }}His*{{ p }}Ti + {{ p }}Hw*TOut + {{ p }}Hms*{{ p }}Tm + {{ p }}fSt*((1 - {{ p }}fIa)*{{ p }}QInt + {{ p }}gA*HGlo))/({{ p }}His + {{ p }}Hw + {{ p }}Hms))
{%- endmacro -%}

{%- macro iso13790_equations(zone, p) -%}
{%- set ts = iso13790_surface_temperature(p) %}
  der({{ p }}Ti) = ({{ p }}Hve*(TOut - {{ p }}Ti) + {{ p }}His*({{ ts }} - {{ p }}Ti) + {{ p }}fIa*{{ p }}QInt
  {%- for coupling in zone.couplings %} + {{ coupling.parameter }}*({{ coupling.neighbour }}Ti - {{ p }}Ti){% endfor %} + {{ p }}QHea)/{{ p }}Ci;
  der({{ p }}Tm) = ({{ p }}Hms*({{ ts }} - {{ p }}Tm) + {{ p }}Hem*(TOut - {{ p }}Tm) + {{ p }}Hg*(TGro - {{ p }}Tm) + {{ p }}fM*((1 - {{ p }}fIa)*{{ p }}QInt + {{ p }}gA*HGlo))/{{ p }}Cm;
{%- endmacro -%}

{%- macro zone_equations(zone, p) -%}
{%- if zone.model_type == "R1C1" -%}{{ r1c1_equations(zone, p) }}
{%- elif zone.model_type == "R3C2" -%}{{ r3c2_equations(zone, p) }}
{%- elif zone.model_type == "R4C3" -%}{{ r4c3_equations(zone, p) }}
{%- elif zone.model_type == "ISO13790" -%}{{ iso13790_equations(zone, p) }}
{%- endif -%}
{%- endmacro -%}

{%- macro zone_declarations(zone, p) -%}
{% for parameter in zone.parameters %}
  parameter Real {{ p }}{{ parameter.name }}(unit="{{ parameter.unit }}") = {{ parameter.value | mo }}
    "{{ parameter.description }}";
{% endfor %}
  input Real {{ p }}QInt(unit="W") "Internal heat gains (occupants, appliances, lighting)";
  input Real {{ p }}QHea(unit="W") "Heating (> 0) or cooling (< 0) power, control input";
{% for state in zone.states %}
  Real {{ p }}{{ state.name }}(unit="K", start={{ zone.temperature_initial | mo }}, fixed=true)
    "{{ state.description }}";
{% endfor %}
{%- endmacro -%}

{%- macro boundary_declarations(ground_temperature) %}
  parameter Real TGro(unit="K") = {{ ground_temperature | mo }} "Ground temperature below the slab";
  input Real TOut(unit="K") "Outdoor dry-bulb air temperature";
  input Real HGlo(unit="W/m2") "Global horizontal solar irradiance";
{%- endmacro -%}

{%- macro zones_library(library_zones, ground_temperature) -%}
{% autoescape false %}
package MPC "CasADi/IPOPT compatible RC models for model predictive control"
package Zones "Single-zone RC models"
{% for zone in library_zones %}
  model {{ zone.model_type }} "{{ zone.title }}"
{{ boundary_declarations(ground_temperature) }}
{{ zone_declarations(zone, "") }}
  equation
{{ zone_equations(zone, "") }}
    annotation (Documentation(info="<html><p>{{ zone.documentation }}</p></html>"));
  end {{ zone.model_type }};

{% endfor %}
end Zones;
end MPC;
{% endautoescape %}
{%- endmacro -%}


{%- macro building_model(building) -%}
{% autoescape false %}
model {{ building.name }} "{{ building.zones | length }}-zone RC building model ({{ building.model_type }}), see Trano.MPC.Zones"
{{ boundary_declarations(building.ground_temperature) }}
{% for coupling in building.couplings %}
  parameter Real {{ coupling.parameter }}(unit="W/K") = {{ coupling.conductance | mo }}
    "Conductance between {{ coupling.zone_a }} and {{ coupling.zone_b }}";
{% endfor %}
{% for zone in building.zones %}
  // ---- Zone {{ zone.name }} ({{ zone.model_type }}) ----
{{ zone_declarations(zone, zone.prefix) }}
{% endfor %}
equation
{% for zone in building.zones %}
{{ zone_equations(zone, zone.prefix) }}
{% endfor %}
end {{ building.name }};
{% endautoescape %}
{%- endmacro -%}
