{#- Package of a network generated with the FastSmoothBuildings library:
    building_mpc   the building made of FastSmoothBuildings components: an explicit ODE whose inputs are the weather data,
                   the internal gains and the controls of the systems (rumoca translates it into CasADi); with
                   containers, it is the container assembly of the other libraries (Components.Containers.building),
                   its inputs at its top;
    building       the runnable model: building_mpc fed with the weather file, the occupancy schedules and the
                   controls replayed from the external data (or held). -#}
{% import 'macros.jinja2' as macros %}
{% import 'Trano.jinja2' as Trano %}
package {{ network.name }}
{{ Trano.Trano_library(None, None, data_bus_connector) }}

{{ modelica_library("FastSmoothBuildings") }}

{{ data.data | safe }}

package Components
{% if include_container %}
  package Containers "Containers of building_mpc"
{% for container in containers %}
    {{ container | safe }}
{% endfor %}
{{ main | safe }}
  end Containers;
{% endif %}
  package BaseClasses "Components of the library with their connections to the data bus"
{% for category in ['control', 'boiler', 'ventilation', 'solar'] %}
{% for component in dynamic_components[category] %}
{{ component | indent(4, first=True) | safe }}
{% endfor %}
{% endfor %}
  end BaseClasses;
end Components;
{% if include_container %}

model building_mpc "{{ network.name }}: building model for MPC (FastSmoothBuildings), an explicit ODE of its inputs"
  extends Components.Containers.building;
end building_mpc;
{% else %}

model building_mpc "{{ network.name }}: building model for MPC (FastSmoothBuildings), an explicit ODE of its inputs"
{% for declaration in databus.model_inputs | map(attribute='model_input.declaration') | unique %}
  {{ declaration | safe }}
{% endfor %}
{% for element_model in element_models %}
  {{ element_model | safe }}
{% endfor %}
equation
{% for edge in network.edge_attributes %}
  {{ edge.equation }}
{% endfor %}
{% for input in databus.model_inputs %}
  connect({{ input.model_input.port }}, {{ databus.name }}.dataBus.{{ input.bus_member }});
{% endfor %}
end building_mpc;
{% endif %}

model building "{{ network.name }}: building_mpc with the weather file, the occupancy schedules and the controls"
{% for parts in runnable if parts.declaration %}
  {{ parts.declaration | safe }}
{% endfor %}
  building_mpc mpc(
    {{- runnable | map(attribute='modifier') | select | join(',\n    ') | safe -}}
  ) "Building model";
equation
{% for parts in runnable if parts.equation %}
  {{ parts.equation | safe }}
{% endfor %}
end building;
end {{ network.name }};
